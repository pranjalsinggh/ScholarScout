# ── ScholarScout environment configuration ──────────────────────────
# Copy to .env for local development. Production requires the secret and hosts below.
# Local analysis and extractive chat work without keys. Connected research
# lookups are a separate per-session choice and use public APIs.

# Polite contact for Crossref/arXiv
CONTACT_EMAIL=you@example.com

# Optional free OpenAlex key for a larger daily API budget.
# Get one at https://openalex.org/settings/api; stored only on the server.
OPENALEX_API_KEY=

# ── LLM synthesis (chat answers) ────────────────────────────────────
# Free-tier friendly: get keys at aistudio.google.com (Gemini) and
# console.groq.com (Groq). Providers are tried in chain order and fall
# back to each other; with no keys the app uses deterministic
# extractive answers (fully functional, no external calls).
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENAI_API_KEY=sk-...

# Override models if you like (defaults shown)
# GEMINI_MODEL=gemini-3-flash-preview
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4o-mini

# Which providers to try, in order (only configured ones are used)
# LLM_PROVIDER_CHAIN=gemini,groq,openai
# LLM_CALLS_PER_PROVIDER_HOUR=120
# Optional USD cost estimates per 1M tokens (set your actual provider rates):
# GEMINI_INPUT_USD_PER_M=
# GEMINI_OUTPUT_USD_PER_M=
# GROQ_INPUT_USD_PER_M=
# GROQ_OUTPUT_USD_PER_M=
# OPENAI_INPUT_USD_PER_M=
# OPENAI_OUTPUT_USD_PER_M=
# Cloud answers are still off for each new visitor until they opt in from chat.
# Production also requires both flags after reviewing each configured provider's
# data policy. Free Gemini may use submitted content for product improvement;
# confidential manuscripts must use local mode or a suitable provider plan.
CLOUD_AI_ENABLED=0
CLOUD_PROVIDER_DATA_APPROVED=0
LLM_CALLS_PER_OWNER_HOUR=12

# Embeddings run locally so indexing never sends paper passages to a provider.

# ── Other optional features ─────────────────────────────────────────
# News tab works out of the box via the free GDELT index (no key needed).
# Optional upgrade for richer headlines (newsapi.org free tier):
# NEWS_API_KEY=...

# Pipeline tuning
MAX_UPLOAD_MB=60
MAX_REQUEST_MB=65
MAX_PDF_PAGES=300
MAX_PDF_TEXT_CHARS=1500000
MAX_PDF_CHUNKS=3000
MAX_SESSION_CHUNKS=10000
PDF_PARSE_TIMEOUT_SECONDS=25
PDF_WORKER_MEMORY_MB=512
ANALYSIS_WORKERS=2
MAX_PENDING_ANALYSES=12
MAX_PENDING_ANALYSES_PER_OWNER=2
MAX_SESSION_PAPERS=10
MAX_SESSION_STORAGE_MB=150
MAX_TOTAL_STORAGE_MB=1000
MAX_TOTAL_EXTRACTED_STORAGE_MB=150
MAX_CONCURRENT_INGESTIONS=2
MAX_ACTIVE_SESSIONS=1000
MAX_NEW_SESSIONS_PER_IP_HOUR=30
MAX_CONCURRENT_REQUESTS=24
MAX_CONCURRENT_REQUESTS_PER_OWNER=4
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
OPENALEX_MAX_CITING=120
RATE_LIMIT_PER_MINUTE=30

# Privacy: erase abandoned anonymous sessions after N idle hours. The browser
# also sends a best-effort delete request when its tab is closed or left.
# Values below 1 are treated as 1; there is no indefinite retention mode.
RETENTION_HOURS=1

# Optional: serve frontend/dist directly from FastAPI, and/or auto-load the
# bundled demo paper for each new anonymous visitor. The Compose demo profile
# sets these for its separate :8081 service.
# SERVE_FRONTEND=0
# FRONTEND_DIST_DIR=/path/to/frontend/dist
# DEMO_AUTOLOAD=0

# Database (SQLite by default; PostgreSQL-ready)
# DATABASE_URL=postgresql://user:pass@localhost/scholarscout

# Render Blueprint sets these automatically. For another production deployment:
# APP_ENV=production
# SCHOLARSCOUT_SECRET_KEY=   # generate at least 32 random characters; never commit
# ALLOWED_HOSTS=scholarscout.example.com
# CORS_ORIGINS=https://scholarscout.example.com
# SCHOLARSCOUT_DATA_DIR=/tmp/scholarscout
# PORT=8000
# FORWARDED_ALLOW_IPS=127.0.0.1   # concrete trusted proxy IPs; see deployment guide
# TRUST_RENDER_EDGE=0            # Blueprint sets 1 only behind Render/Cloudflare
