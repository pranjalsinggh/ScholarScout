{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (FastAPI :8000)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--port", "8000", "--reload"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "scholarscout" }
    },
    {
      "label": "Run Frontend (Vite :5173)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "scholarscout" }
    },
    {
      "label": "Run ScholarScout (backend + frontend)",
      "dependsOn": ["Run Backend (FastAPI :8000)", "Run Frontend (Vite :5173)"],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
