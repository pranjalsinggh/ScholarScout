FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS frontend-build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend ./
RUN npm run build

FROM python:3.11.17-slim-trixie@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 SERVE_FRONTEND=1 \
    FRONTEND_DIST_DIR=/app/frontend/dist SCHOLARSCOUT_DATA_DIR=/tmp/scholarscout \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app/backend
COPY backend/requirements.txt backend/requirements.lock.txt ./
RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.txt \
    && python -m pip check \
    && python -m pip uninstall --yes pip setuptools wheel \
    && useradd --system --uid 10001 --user-group --create-home scholar
COPY backend/app ./app
COPY backend/demo_assets ./demo_assets
COPY --from=frontend-build /frontend/dist /app/frontend/dist
COPY scripts/start_server.py scripts/healthcheck.py scripts/release_gate.py /app/scripts/
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=6s --start-period=60s --retries=3 \
    CMD ["python", "/app/scripts/healthcheck.py"]
CMD ["python", "/app/scripts/start_server.py"]
