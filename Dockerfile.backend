FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS frontend-build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend ./
RUN npm run build

FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS python-build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY backend/requirements.txt backend/requirements.lock.txt ./
RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.txt \
    && python -m pip check \
    && python -m pip uninstall --yes pip setuptools wheel
# Preserve package records/copyright alongside the added shared libraries.
COPY scripts/build_runtime.py ./build_runtime.py
RUN python build_runtime.py

# A maintained runtime image without shells, package managers or mount tools.
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2
ENV PATH=/usr/local/bin:/usr/bin:/bin \
    LD_LIBRARY_PATH=/usr/local/lib \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SERVE_FRONTEND=1 \
    FRONTEND_DIST_DIR=/app/frontend/dist SCHOLARSCOUT_DATA_DIR=/tmp/scholarscout \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
COPY --from=python-build /usr/local /usr/local
COPY --from=python-build /runtime-libs/ /
WORKDIR /app/backend
COPY backend/app ./app
COPY backend/demo_assets ./demo_assets
COPY --from=frontend-build /frontend/dist /app/frontend/dist
COPY scripts/start_server.py scripts/healthcheck.py scripts/release_gate.py /app/scripts/
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=6s --start-period=60s --retries=3 \
    CMD ["python", "/app/scripts/healthcheck.py"]
CMD ["python", "/app/scripts/start_server.py"]
